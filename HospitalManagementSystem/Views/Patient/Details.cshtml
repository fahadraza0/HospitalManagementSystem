@model HospitalManagementSystem.Models.TreatmentRecord
@{
    var medicines = ViewBag.Medicines as List<HospitalManagementSystem.Models.TreatmentMedicine>;
}

<h2>Treatment Record Details</h2>

<table class="table table-bordered">
    <tr><th>Date</th><td>@Model.TreatmentDate.ToString("yyyy-MM-dd HH:mm")</td></tr>
    <tr><th>Doctor</th><td>@Model.Doctor?.FullName</td></tr>
    <tr><th>Patient</th><td>@Model.Patient?.FullName</td></tr>
    <tr><th>Diagnosis</th><td>@Model.Diagnosis</td></tr>
    <tr><th>Prescriptions</th><td>@Model.Prescriptions</td></tr>
</table>

<h4>Prescribed Medicines</h4>
@if (medicines != null && medicines.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Quantity</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var med in medicines)
            {
                <tr>
                    <td>@med.Medicine?.Name</td>
                    <td>@med.Quantity</td>
                    <td>@med.Medicine?.Price</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No medicines prescribed.</p>
}

<a class="btn btn-secondary" href="@Url.Action("MedicalHistory", "Patient")">Back to Medical History</a>
