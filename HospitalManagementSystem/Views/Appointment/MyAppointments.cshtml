@model IEnumerable<HospitalManagementSystem.Models.Appointment>

<h2 class="mt-4">Appointments</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Book" class="btn btn-primary">
        <i class="fas fa-calendar-plus"></i> Book Appointment
    </a>
</div>

<table id="appointmentTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.Patient.FullName</td>
                <td>@appointment.Doctor.FullName</td>
                <td>@appointment.AppointmentDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @(new DateTime().Add(appointment.StartTime).ToString("hh:mm tt")) -
                    @(new DateTime().Add(appointment.EndTime).ToString("hh:mm tt"))
                </td>
                <td>
                    @if (appointment.Status == "Confirmed")
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (appointment.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    // Ensure jQuery is loaded before initializing DataTables
    if (typeof jQuery !== 'undefined') {
        $(document).ready(function () {
            $('#appointmentTable').DataTable({
                "paging": true,
                "lengthMenu": [10, 25, 50, 100],
                "ordering": true,
                "info": true,
                "responsive": true,
                "language": {
                    "search": "🔍 Search:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "infoEmpty": "No entries available",
                    "zeroRecords": "No matching records found"
                }
            });

            // Dark mode styling for DataTables
            function applyDarkMode() {
                if ($('body').hasClass('dark-mode')) {
                    $('.dataTables_wrapper').css({
                        'background-color': '#333',
                        'color': '#fff'
                    });
                    $('.dataTables_length select, .dataTables_filter input').css({
                        'background-color': '#555',
                        'color': '#fff',
                        'border': '1px solid #777'
                    });
                    $('.dataTables_info, .dataTables_paginate').css({
                        'color': '#fff'
                    });
                } else {
                    $('.dataTables_wrapper').removeAttr('style');
                    $('.dataTables_length select, .dataTables_filter input').removeAttr('style');
                    $('.dataTables_info, .dataTables_paginate').removeAttr('style');
                }
            }

            // Dark mode toggle listener
            $('.dark-mode-toggle').on('click', function () {
                $('body').toggleClass('dark-mode');
                applyDarkMode();
            });

            // Apply dark mode on page load if enabled
            if (localStorage.getItem('darkMode') === 'true') {
                $('body').addClass('dark-mode');
                applyDarkMode();
            }
        });
    } else {
        console.error("jQuery is not loaded.");
    }
</script>
