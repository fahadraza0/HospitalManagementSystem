@model IEnumerable<HospitalManagementSystem.Models.Staff>

@{
    ViewData["Title"] = "Staff Management";
}

<h2>Staff Management</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Staff</a>

<table class="table table-bordered table-striped" id="staffManagementTable">
    <thead class="thead-dark">
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Ward</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var staff in Model)
        {
            <tr>
                <td>@staff.FullName</td>
                <td>@staff.Email</td>
                <td>@staff.PhoneNumber</td>
                <td>@staff.Department</td>
                <td>@staff.AssignedWard</td>
                <td>@staff.Role</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@staff.StaffId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@staff.StaffId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Delete" asp-route-id="@staff.StaffId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
        $(document).ready(function() {
        $('#staffManagementTable').DataTable({
            "paging": true,
            "lengthMenu": [10, 25, 50, 100],
            "ordering": true,
            "info": true,
            "responsive": true,
            "language": {
                "search": "🔍 Search:",
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                "infoEmpty": "No entries available",
                "zeroRecords": "No matching records found"
            }
        });
    });
</script>