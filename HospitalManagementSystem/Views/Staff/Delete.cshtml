@model HospitalManagementSystem.Models.Staff

@{
    ViewData["Title"] = "Delete Staff";
}

<h2>Confirm Delete</h2>
<h3>Are you sure you want to delete this staff member?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.FullName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>

        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Department</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="StaffId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
