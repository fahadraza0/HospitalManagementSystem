@model HospitalManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Medicine Details";
}

<h2 class="mt-4"><i class="fas fa-info-circle"></i> Medicine Details</h2>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-lg p-4">
            <div class="card-body">
                <h4 class="text-dark"><i class="fas fa-capsules"></i> Medicine Information</h4>
                <hr />

                <dl class="row">
                    <!-- Medicine Name -->
                    <dt class="col-sm-4 text-secondary">
                        <i class="fas fa-pills"></i> @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-8 fw-bold text-dark">
                        @Html.DisplayFor(model => model.Name)
                    </dd>

                    <!-- Price -->
                    <dt class="col-sm-4 text-secondary">
                        <i class="fas fa-dollar-sign"></i> @Html.DisplayNameFor(model => model.Price)
                    </dt>
                    <dd class="col-sm-8 fw-bold text-dark">
                        $@Html.DisplayFor(model => model.Price)
                    </dd>
                </dl>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.MedicineId" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
