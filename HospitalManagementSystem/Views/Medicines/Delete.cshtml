@model HospitalManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<h2 class="mt-4 text-danger"><i class="fas fa-trash-alt"></i> Delete Confirmation</h2>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-body">
                <h4 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this medicine?</h4>
                <hr />

                <dl class="row">
                    <!-- Medicine Name -->
                    <dt class="col-sm-4 text-secondary">
                        <i class="fas fa-pills"></i> @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-8 fw-bold text-dark">
                        @Html.DisplayFor(model => model.Name)
                    </dd>

                    <!-- Price -->
                    <dt class="col-sm-4 text-secondary">
                        <i class="fas fa-dollar-sign"></i> @Html.DisplayNameFor(model => model.Price)
                    </dt>
                    <dd class="col-sm-8 fw-bold text-dark">
                        $@Html.DisplayFor(model => model.Price)
                    </dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="MedicineId" />

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
