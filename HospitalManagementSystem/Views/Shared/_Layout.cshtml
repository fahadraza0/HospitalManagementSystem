<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Hospital Management System</title>

	<!-- ✅ Bootstrap & Custom Styles -->
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/HospitalManagementSystem.styles.css" asp-append-version="true" />
	<!-- DataTable CSS (use only one version) -->
	<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet">

	<!-- jQuery (needed for DataTable to function) -->
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	<!-- DataTable JS -->
	<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

	<!-- Font Awesome CSS for icons -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

	<link href="~/css/site.css" rel="stylesheet">
</head>

<body>

	<!-- 🌟 Navbar -->
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark">
			<div class="container-fluid">
				<a class="navbar-brand" asp-controller="Home" asp-action="Index">Hospital Management System</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
						aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarNav">
					<partial name="_LoginPartial" />
					<button class="btn dark-mode-toggle ms-3" onclick="toggleDarkMode()">🌙 Dark Mode</button>
				</div>
			</div>
		</nav>
	</header>

	<!-- 🌟 Sidebar & Content -->
	<div class="container-wrapper">
		<!-- Hamburger Icon (Toggle Sidebar) -->
		<div class="hamburger-menu" id="hamburger">
			<button class="navbar-toggler" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">
				<span class="fas fa-bars"></span>
			</button>
		</div>
		<div class="sidebar collapse" id="sidebar">
			<ul class="nav flex-column">

				<!-- 🔥 Always Visible to All -->
				<li class="nav-item @((ViewData["ActivePage"] as string) == "Dashboard" ? "active" : "")">
					<a class="nav-link" asp-controller="Home" asp-action="Index">
						<i class="fas fa-home"></i> Home
					</a>
				</li>

				<!-- ✅ Admin Access -->
				@if (User.IsInRole("Admin"))
				{
					<li class="nav-item @((ViewData["ActivePage"] as string) == "Team" ? "active" : "")">
						<a class="nav-link" asp-controller="Team" asp-action="Index">
							<i class="fas fa-users-cog"></i> Team
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Staff" ? "active" : "")">
						<a class="nav-link" asp-controller="Staff" asp-action="Index">
							<i class="fas fa-user-tie"></i> Staff
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Ward" ? "active" : "")">
						<a class="nav-link" asp-controller="Ward" asp-action="Index">
							<i class="fas fa-procedures"></i> Wards
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Doctor" ? "active" : "")">
						<a class="nav-link" asp-controller="Doctor" asp-action="Index">
							<i class="fas fa-stethoscope"></i> Doctors
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Medicines" ? "active" : "")">
						<a class="nav-link" asp-controller="Medicines" asp-action="Index">
							<i class="fas fa-vials"></i> Medicines
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Patient" ? "active" : "")">
						<a class="nav-link" asp-controller="Patient" asp-action="Index">
							<i class="fas fa-user-injured"></i> Patients
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Treatment" ? "active" : "")">
						<a class="nav-link" asp-controller="Treatment" asp-action="Create">
							<i class="fas fa-user-nurse"></i> Treatment
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Appointment" ? "active" : "")">
						<a class="nav-link" asp-controller="Appointment" asp-action="Index">
							<i class="fas fa-calendar-check"></i> Appointments
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Billing" ? "active" : "")">
						<a class="nav-link" asp-controller="Billing" asp-action="Index">
							<i class="fas fa-receipt"></i> Bills
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Reports" ? "active" : "")">
						<a class="nav-link" href="#" data-bs-toggle="collapse" data-bs-target="#reportsMenu" aria-expanded="false" aria-controls="reportsMenu">
							<i class="fas fa-file-alt"></i> Reports
						</a>
						<div class="collapse" id="reportsMenu">
							<ul class="nav flex-column ms-3">
								<li class="nav-item @((ViewData["ActivePage"] as string) == "PatientsByWard" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="PatientsByWard">
										<i class="fas fa-procedures"></i> Patients by Ward
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "PatientsByDoctor" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="PatientsByDoctor">
										<i class="fas fa-user-md"></i> Patients by Doctor
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "TeamReports" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="TeamReports">
										<i class="fas fa-users-cog"></i> Teams
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "WardOccupancy" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="WardOccupancy">
										<i class="fas fa-hospital-user"></i> Ward Occupancy
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "DischargeReports" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="DischargeReports">
										<i class="fas fa-file-medical-alt"></i> Discharge Reports
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "AppointmentReports" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="AppointmentReports">
										<i class="fas fa-calendar-alt"></i> Appointment Reports
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "PatientStatistics" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="PatientStatistics">
										<i class="fas fa-chart-bar"></i> Patient Statistics
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "StaffActivityReports" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="StaffActivityReports">
										<i class="fas fa-user-clock"></i> Staff Activity
									</a>
								</li>

								<li class="nav-item @((ViewData["ActivePage"] as string) == "EmergencyConsultations" ? "active" : "")">
									<a class="nav-link" asp-controller="Report" asp-action="EmergencyConsultations">
										<i class="fas fa-ambulance"></i> Emergency Consultations
									</a>
								</li>
							</ul>
						</div>
					</li>
				}

				<!-- ✅ Doctor Access -->
				@if (User.IsInRole("Doctor"))
				{
					<li class="nav-item @((ViewData["ActivePage"] as string) == "MyProfile" ? "active" : "")">
						<a class="nav-link" asp-controller="Doctor" asp-action="Index">
							<i class="fas fa-user-md"></i> My Profile
						</a>
					</li>
						
					<li class="nav-item @((ViewData["ActivePage"] as string) == "Appointment" ? "active" : "")">
						<a class="nav-link" asp-controller="Appointment" asp-action="Index">
							<i class="fas fa-calendar-check"></i> My Appointments
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "MyPatients" ? "active" : "")">
						<a class="nav-link" asp-controller="Patient" asp-action="Index">
							<i class="fas fa-user-injured"></i> My Patients
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Treatment" ? "active" : "")">
						<a class="nav-link" asp-controller="Treatment" asp-action="AddTreatment">
							<i class="fas fa-user-nurse"></i> Patient Treatment
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Reports" ? "active" : "")">
						<a class="nav-link" asp-controller="Report" asp-action="PatientsByDoctor">
							<i class="fas fa-file-medical"></i> My Reports
						</a>
					</li>
				}

				<!-- ✅ Staff Access -->
				@if (User.IsInRole("Staff"))
				{
					<li class="nav-item @((ViewData["ActivePage"] as string) == "WardManagement" ? "active" : "")">
						<a class="nav-link" asp-controller="Ward" asp-action="Index">
							<i class="fas fa-procedures"></i> Ward Management
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "PatientAssistance" ? "active" : "")">
						<a class="nav-link" asp-controller="Patient" asp-action="Index">
							<i class="fas fa-user-injured"></i> Patient Assistance
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Appointment" ? "active" : "")">
						<a class="nav-link" asp-controller="Appointment" asp-action="Index">
							<i class="fas fa-calendar-check"></i> Appointments Assistance
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "Reports" ? "active" : "")">
						<a class="nav-link" asp-controller="Report" asp-action="StaffActivityReports">
							<i class="fas fa-chart-line"></i> Staff Reports
						</a>
					</li>
				}

				<!-- ✅ Patient Access -->
				@if (User.IsInRole("Patient"))
				{
					<li class="nav-item @((ViewData["ActivePage"] as string) == "Appointment" ? "active" : "")">
						<a class="nav-link" asp-controller="Appointment" asp-action="Book">
							<i class="fas fa-calendar-plus"></i> Book Appointment
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "MyAppointments" ? "active" : "")">
						<a class="nav-link" asp-controller="Appointment" asp-action="MyAppointments">
							<i class="fas fa-calendar-check"></i> My Appointments
						</a>
					</li>

					<li class="nav-item @((ViewData["ActivePage"] as string) == "MedicalHistory" ? "active" : "")">
						<a class="nav-link" asp-controller="Patient" asp-action="MedicalHistory">
							<i class="fas fa-file-medical-alt"></i> Medical History
						</a>
					</li>
				}
			</ul>
		</div>

		<main class="main-content">
			@RenderBody()
		</main>
	</div>

	<!-- 🌟 Footer -->
	<footer class="footer">
		<p>&copy; 2025 Hospital Management System | Developed by Fahad Raza</p>
	</footer>
	@RenderSection("Scripts", required: false)

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		 $(document).ready(function () {
			const $sidebar = $('#sidebar');
			const $hamburger = $('#hamburger button');  // Button inside the hamburger menu
			const $mainContent = $('.main-content');

			// Ensure sidebar is initially shown
			$sidebar.addClass('show').removeClass('collapse');

			// Toggle sidebar visibility on hamburger click
			$hamburger.on('click', function () {
				// Log the current state of the sidebar
				console.log("Current sidebar class: " + $sidebar.attr('class'));  // Debugging log

				if ($sidebar.hasClass('show')) {
					// Hide the sidebar and collapse the main content
					$sidebar.removeClass('show').addClass('hide');
					$mainContent.addClass('collapsed');
				} else {
					// Show the sidebar and expand the main content
					$sidebar.removeClass('hide').addClass('show');
					$mainContent.removeClass('collapsed');
				}
			});
		});
		function toggleDarkMode() {
			document.body.classList.toggle("dark-mode");
		}
	</script>
</body>
</html>
