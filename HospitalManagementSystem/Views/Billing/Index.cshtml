@model IEnumerable<HospitalManagementSystem.Models.Billing>
@{
    ViewData["Title"] = "Billing List";
}

<h2>Billing List</h2>

<table class="table table-striped table-bordered mt-3" id="billingListTable">
    <thead class="table-light">
        <tr>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model)
        {
            <tr>
                <td>@bill.Patient.FullName</td>
                <td>@bill.Doctor.FullName</td>
                <td>@bill.TotalAmount.ToString("C")</td>
                <td>
                    <span class="badge @(bill.IsPaid ? "bg-success" : "bg-danger")">
                        @(bill.IsPaid ? "Paid" : "Unpaid")
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@bill.BillingId" class="btn btn-info btn-sm">Details</a>
                    @if (!bill.IsPaid)
                    {
                        <form asp-action="MarkAsPaid" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@bill.BillingId" />
                            <button type="submit" class="btn btn-success btn-sm">Mark as Paid</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
        $(document).ready(function() {
        $('#billingListTable').DataTable({
            "paging": true,
            "lengthMenu": [10, 25, 50, 100],
            "ordering": true,
            "info": true,
            "responsive": true,
            "language": {
                "search": "🔍 Search:",
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                "infoEmpty": "No entries available",
                "zeroRecords": "No matching records found"
            }
        });
    });
</script>