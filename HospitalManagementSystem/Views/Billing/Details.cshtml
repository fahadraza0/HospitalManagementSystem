@model HospitalManagementSystem.Models.Billing
@{
    ViewData["Title"] = "Billing Details";
}

<h2 class="mb-4">Billing Details</h2>

<div class="card">
    <div class="card-header bg-primary text-white">
        Billing for Patient: @Model.Patient.FullName
    </div>
    <div class="card-body">
        <p><strong>Doctor:</strong> @Model.Doctor.FullName</p>
        <p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("C")</p>
        <p>
            <strong>Status:</strong>
            <span class="badge @(Model.IsPaid ? "bg-success" : "bg-danger")">
                @(Model.IsPaid ? "Paid" : "Unpaid")
            </span>
        </p>

        <h5 class="mt-4">Medicines</h5>
        @if (Model.TreatmentMedicines != null && Model.TreatmentMedicines.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var med in Model.TreatmentMedicines)
                    {
                        <tr>
                            <td>@med.Medicine.Name</td>
                            <td>@med.Quantity</td>
                            <td>@med.Medicine.Price.ToString("C")</td>
                            <td>@(med.Quantity * med.Medicine.Price).ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No medicines billed.</p>
        }

        <a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>
    </div>
</div>
