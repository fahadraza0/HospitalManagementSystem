@model IEnumerable<HospitalManagementSystem.ViewModel.WardOccupancyViewModel>

@{
    ViewData["Title"] = "Ward Occupancy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Ward Occupancy Report</h2>

<div class="table-responsive">
    <table class="table table-bordered table-hover" id="wardReportTable">
        <thead class="thead-dark">
            <tr>
                <th>Ward Name</th>
                <th>Total Beds</th>
                <th>Occupied Beds</th>
                <th>Available Beds</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ward in Model)
            {
                <tr>
                    <td>@ward.WardName</td>
                    <td>@ward.TotalBeds</td>
                    <td>@ward.OccupiedBeds</td>
                    <td>@ward.AvailableBeds</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#wardReportTable').DataTable({
                paging: true,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                info: true,
                responsive: true,
                language: {
                    search: "🔍 Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "No entries available",
                    zeroRecords: "No matching records found"
                }
            });
        });
    </script>
}
