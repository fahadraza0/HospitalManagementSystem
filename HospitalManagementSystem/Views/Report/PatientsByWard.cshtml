@model IEnumerable<HospitalManagementSystem.Models.Ward>

<h2>Patients By Ward</h2>

<table class="table" id="patientsByWardTable">
    <thead>
        <tr>
            <th>Ward</th>
            <th>Capacity</th>
            <th>Current Occupancy</th>
            <th>Patients</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ward in Model)
        {
            <tr>
                <td>@ward.WardName</td>
                <td>@ward.Capacity</td>
                <td>@ward.CurrentOccupancy</td>
                <td>
                    @foreach (var patient in ward.Patients)
                    {
                        <p>@patient.FullName</p>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
        $(document).ready(function() {
        $('#patientsByWardTable').DataTable({
            "paging": true,
            "lengthMenu": [10, 25, 50, 100],
            "ordering": true,
            "info": true,
            "responsive": true,
            "language": {
                "search": "🔍 Search:",
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                "infoEmpty": "No entries available",
                "zeroRecords": "No matching records found"
            }
        });
    });
</script>