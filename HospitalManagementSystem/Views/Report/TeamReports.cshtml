@model IEnumerable<HospitalManagementSystem.Models.Team>

<h2>Team Reports</h2>

<table class="table" id="teamReportsTable">
	<thead>
		<tr>
			<th>Team</th>
			<th>Doctors</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var team in Model)
		{
			<tr>
				<td>@team.TeamName</td>
				<td>
					@foreach (var doctor in team.Doctors ?? new List<HospitalManagementSystem.Models.Doctor>())
					{
						<p>@doctor.FullName</p>
					}
				</td>
			</tr>
		}
	</tbody>
</table>
<script>
		$(document).ready(function() {
		$('#teamReportsTable').DataTable({
			"paging": true,
			"lengthMenu": [10, 25, 50, 100],
			"ordering": true,
			"info": true,
			"responsive": true,
			"language": {
				"search": "🔍 Search:",
				"lengthMenu": "Show _MENU_ entries",
				"info": "Showing _START_ to _END_ of _TOTAL_ entries",
				"infoEmpty": "No entries available",
				"zeroRecords": "No matching records found"
			}
		});
	});
</script>