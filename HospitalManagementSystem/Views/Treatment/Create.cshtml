@model HospitalManagementSystem.ViewModel.TreatmentRecordViewModel

<h2>Add Treatment Record</h2>

<form asp-action="Create" method="post">

    @if (User.IsInRole("Admin"))
    {
        <div class="form-group">
            <label for="DoctorId">Doctor</label>
            <select id="DoctorId" asp-for="TreatmentRecord.DoctorId" class="form-control" required>
                <option value="">-- Select Doctor --</option>
                @foreach (var doctor in ViewBag.Doctors as List<HospitalManagementSystem.Models.Doctor>)
                {
                    <option value="@doctor.DoctorId">@doctor.FullName</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="PatientId">Patient</label>
            <select id="PatientId" asp-for="TreatmentRecord.PatientId" class="form-control" required>
                <option value="">-- Select Patient --</option>
            </select>
        </div>
    }
    else if (User.IsInRole("Doctor"))
    {
        <input type="hidden" asp-for="TreatmentRecord.DoctorId" value="@ViewBag.DoctorId" />

        <div class="form-group">
            <label for="PatientId">Patient</label>
            <select id="PatientId" asp-for="TreatmentRecord.PatientId" class="form-control" required>
                <option value="">-- Select Patient --</option>
                @foreach (var patient in ViewBag.Patients as List<HospitalManagementSystem.Models.Patient>)
                {
                    <option value="@patient.PatientId">@patient.FullName</option>
                }
            </select>
        </div>
    }

    <div class="form-group">
        <label asp-for="TreatmentRecord.Diagnosis">Diagnosis</label>
        <input asp-for="TreatmentRecord.Diagnosis" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="TreatmentRecord.Prescriptions">Prescriptions</label>
        <textarea asp-for="TreatmentRecord.Prescriptions" class="form-control" required></textarea>
    </div>

    <h4>Medicines</h4>
    <div id="medicinesContainer">
        @for (int i = 0; i < Model.MedicinesWithQuantities.Count; i++)
        {
            <div class="form-group row medicine-row">
                <div class="col-md-6">
                    <label>Medicine</label>
                    <select name="MedicinesWithQuantities[@i].MedicineId" class="form-control">
                        <option value="">-- Select Medicine --</option>
                        @foreach (var med in Model.Medicines)
                        {
                            <option value="@med.MedicineId">@med.Name (@med.Price)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label>Quantity</label>
                    <input type="number" name="MedicinesWithQuantities[@i].Quantity" class="form-control" value="1" min="1" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-danger remove-medicine">Remove</button>
                </div>
            </div>
        }
    </div>

    <button type="button" class="btn btn-secondary mb-3" id="addMedicine">+ Add Medicine</button>
    <br />

    <button type="submit" class="btn btn-primary">Save Treatment Record</button>
    <a href="@Url.Action("History", "Treatment", new { patientId = ViewBag.PatientId })" class="btn btn-secondary">Back to History</a>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        $(document).ready(function () {

            let medIndex = @Model.MedicinesWithQuantities.Count;

            // Add new medicine row
            $('#addMedicine').click(function () {
                const medicineOptions = `@foreach (var med in Model.Medicines)
        {
            <text><option value="@med.MedicineId">@med.Name (@med.Price)</option></text>
        }`;

                const newRow = `
                <div class="form-group row medicine-row">
                    <div class="col-md-6">
                        <label>Medicine</label>
                        <select name="MedicinesWithQuantities[${medIndex}].MedicineId" class="form-control">
                            <option value="">-- Select Medicine --</option>
                            ${medicineOptions}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Quantity</label>
                        <input type="number" name="MedicinesWithQuantities[${medIndex}].Quantity" class="form-control" value="1" min="1" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button" class="btn btn-danger remove-medicine">Remove</button>
                    </div>
                </div>`;

                $('#medicinesContainer').append(newRow);
                medIndex++;
            });

            // Remove medicine row
            $(document).on('click', '.remove-medicine', function () {
                $(this).closest('.medicine-row').remove();
            });

            // AJAX for Admin: Load patients for selected doctor
        @if (User.IsInRole("Admin"))
        {
            <text>
                    $('#DoctorId').change(function () {
                        var doctorId = $(this).val();
                        $('#PatientId').empty().append("<option value=''>-- Select Patient --</option>");

                        if (doctorId) {
                            $.ajax({
                                url: '/Treatment/GetPatientsByDoctor?doctorId=' + doctorId,
                                type: 'GET',
                                dataType: 'json',
                                success: function (data) {
                                    if (data && data.length > 0) {
                                        $.each(data, function (index, patient) {
                                                $('#PatientId').append(`<option value=${patient.patientId}>${patient.fullName}</option>`);
                                        });
                                    } else {
                                        $('#PatientId').append("<option value=''>No patients assigned to this doctor</option>");
                                    }
                                },
                                error: function () {
                                    alert('Error loading patients.');
                                }
                            });
                        }
                    });
            </text>
        }
        });
    </script>
}
