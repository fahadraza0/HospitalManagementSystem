@model HospitalManagementSystem.ViewModel.TreatmentRecordDetailsViewModel

<h2>Treatment Record Details</h2>

<table class="table table-bordered">
    <tr><th>Date</th><td>@Model.Treatment?.TreatmentDate.ToString("yyyy-MM-dd HH:mm")</td></tr>
    <tr><th>Doctor</th><td>@Model.Treatment?.Doctor?.FullName</td></tr>
    <tr><th>Patient</th><td>@Model.Treatment?.Patient?.FullName</td></tr>
    <tr><th>Diagnosis</th><td>@Model.Treatment?.Diagnosis</td></tr>
    <tr><th>Prescriptions</th><td>@Model.Treatment?.Prescriptions</td></tr>
</table>

<h4>Prescribed Medicines</h4>
@if (Model.Medicines != null && Model.Medicines.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Quantity</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var med in Model.Medicines)
            {
                <tr>
                    <td>@med.Medicine?.Name</td>
                    <td>@med.Quantity</td>
                    <td>@med.Medicine?.Price</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No medicines prescribed.</p>
}

<a class="btn btn-secondary" href="@Url.Action("MedicalHistory", "Patient", new { patientId = Model.Treatment?.PatientId })">Back to History</a>
