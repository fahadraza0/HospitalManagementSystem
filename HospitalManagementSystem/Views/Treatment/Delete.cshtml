@model HospitalManagementSystem.Models.TreatmentRecord

<h2>Delete Treatment Record</h2>

<div>
    <h4>Are you sure you want to delete this treatment record?</h4>
    <dl class="row">
        <dt class="col-sm-2">Doctor</dt>
        <dd class="col-sm-10">@Model.Doctor.FullName</dd>

        <dt class="col-sm-2">Diagnosis</dt>
        <dd class="col-sm-10">@Model.Diagnosis</dd>

       @*  <dt class="col-sm-2">Prescriptions</dt>
        <dd class="col-sm-10">@Model.Prescriptions</dd> *@

        <dt class="col-sm-2">Treatment Date</dt>
        <dd class="col-sm-10">@Model.TreatmentDate.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="RecordId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("History", "Treatment", new { patientId = Model.PatientId })" class="btn btn-secondary">Cancel</a>
    </form>
</div>
