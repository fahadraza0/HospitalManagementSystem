@model IEnumerable<HospitalManagementSystem.Models.Doctor>
<div id="calendar"></div>
<script src="~/js/calendar.js"></script>

<h2>Doctor List</h2>
<a asp-action="Create" class="btn btn-primary">Add Doctor</a>

<!-- DataTable for Doctor List -->
<table id="doctorTable" class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Specialization</th>
            <th>Availability</th>
            <th>Teams</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.FullName</td>
                <td>@doctor.Specialization</td>
                <td>@(doctor.IsAvailable ? "Available" : "Unavailable")</td>
                <td>@(doctor.TeamId.HasValue && doctor.Team != null ? doctor.Team.TeamName : "No Team Assigned")</td>
                <td>
                    <a asp-action="AssignPatient" asp-route-id="@doctor.DoctorId" class="btn btn-info">Assign Patient</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    // Initialize DataTable
    $(document).ready(function() {
        $('#doctorTable').DataTable({
            "paging": true,
            "lengthMenu": [10, 25, 50, 100],
            "ordering": true,
            "info": true,
            "responsive": true,
            "language": {
                "search": "🔍 Search:",
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                "infoEmpty": "No entries available",
                "zeroRecords": "No matching records found"
            }
        });
    });
</script>
