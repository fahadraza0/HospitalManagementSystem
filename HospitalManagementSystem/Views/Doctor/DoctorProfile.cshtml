@model HospitalManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "My Profile";
}

<h2 class="mt-4 mb-4">Doctor Profile</h2>

<div class="card shadow p-4">
    <div class="row">
        <div class="col-md-6">
            <h4>@Model.FullName</h4>
            <p><strong>Specialization:</strong> @Model.Specialization</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Phone:</strong> @Model.PhoneNumber</p>
            <p><strong>Experience:</strong> @Model.Experience years</p>
            <p><strong>Hourly Rate:</strong> Rs. @Model.HourlyRate</p>
            <p><strong>Team:</strong> @(Model.Team != null ? Model.Team.TeamName : "No Team Assigned")</p>
            <p><strong>Availability:</strong> @(Model.IsAvailable ? "Available" : "Not Available")</p>
            <p><strong>Assigned Patients:</strong> @Model.AssignedPatientsCount</p>
        </div>
    </div>
</div>
