@page
@model AccessDeniedModel
@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f4f4f4;
            font-family: Arial, sans-serif;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .access-denied-container {
            background: white;
            padding: 40px 30px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            max-width: 600px;
            text-align: center;
        }

        h1 {
            font-size: 2.5rem;
            color: #dc3545;
            margin-bottom: 20px;
        }

        p {
            font-size: 1.2rem;
            color: #555;
        }

        .btn-back {
            background-color: #007bff;
            color: white;
            text-decoration: none;
            padding: 10px 25px;
            border-radius: 6px;
            transition: background 0.3s;
        }

            .btn-back:hover {
                background-color: #0056b3;
            }

        .btn-home {
            background-color: #28a745;
            color: white;
            text-decoration: none;
            padding: 10px 25px;
            border-radius: 6px;
            transition: background 0.3s;
        }

            .btn-home:hover {
                background-color: #218838;
            }
    </style>
</head>
<body>

    <div class="access-denied-container">
        <h1>🚫 Access Denied</h1>
        <p>You do not have permission to access this resource.</p>

        <div class="mt-4">
            <a href="javascript:history.back()" class="btn-back me-3">🔙 Go Back</a>
            <a asp-page="/Index" class="btn-home">🏠 Home</a>
        </div>
    </div>

</body>
</html>
