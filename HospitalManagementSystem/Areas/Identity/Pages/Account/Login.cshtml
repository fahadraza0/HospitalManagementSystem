@page
@model LoginModel

@{
	Layout = null;  // Disable _Layout.cshtml
	ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewData["Title"]</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

	<style>
		body {
			background: linear-gradient(135deg, #74EBD5, #ACB6E5);
			height: 100vh;
			display: flex;
			justify-content: center;
			align-items: center;
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
			color: #333;
			margin: 0;
		}

		.login-container {
			background: white;
			border-radius: 12px;
			box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
			max-width: 900px;
			width: 100%;
			overflow: hidden;
			display: flex;
		}

		.login-left {
			background: #007bff;
			color: white;
			padding: 60px 40px;
			width: 45%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			text-align: center;
		}

			.login-left h2 {
				font-size: 2.2rem;
				margin-bottom: 20px;
			}

			.login-left p {
				font-size: 1.1rem;
				margin-bottom: 30px;
			}

			.login-left i {
				font-size: 4rem;
				margin-bottom: 20px;
			}

		.login-right {
			padding: 60px 50px;
			width: 55%;
		}

		h1 {
			font-size: 2.5rem;
			color: #007bff;
			text-align: center;
			margin-bottom: 20px;
		}

		.form-floating label {
			color: #6c757d;
		}

		.btn-primary {
			background: #007bff;
			border: none;
			transition: background 0.3s;
		}

			.btn-primary:hover {
				background: #0056b3;
			}

		.btn-external {
			background: #28a745;
			color: white;
			width: 100%;
			border: none;
			transition: background 0.3s;
		}

			.btn-external:hover {
				background: #218838;
			}

		a {
			color: #007bff;
			text-decoration: none;
		}

			a:hover {
				color: #0056b3;
				text-decoration: underline;
			}

		.form-check-input {
			cursor: pointer;
		}

		.external-providers {
			display: flex;
			justify-content: space-between;
		}

			.external-providers button {
				flex: 1;
				margin: 5px;
			}
	</style>
</head>

<body>

	<div class="login-container">

		<!-- ✅ Left Side (Intro) -->
		<div class="login-left">
			<i class="fas fa-user-lock"></i>
			<h2>Welcome Back!</h2>
			<p>Log in to access your account and manage hospital records efficiently.</p>
		</div>

		<!-- ✅ Right Side (Form) -->
		<div class="login-right">
			<h1>@ViewData["Title"]</h1>

			<form id="account" method="post">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>

				<div class="form-floating mb-3">
					<input asp-for="Input.EmailOrUsername" class="form-control" autocomplete="username" aria-required="true" placeholder="Email or Username" />
					<label asp-for="Input.EmailOrUsername">Email or Username</label>
					<span asp-validation-for="Input.EmailOrUsername" class="text-danger"></span>
				</div>

				<div class="form-floating mb-3">
					<input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
					<label asp-for="Input.Password">Password</label>
					<span asp-validation-for="Input.Password" class="text-danger"></span>
				</div>

				<div class="form-check mb-3">
					<input class="form-check-input" asp-for="Input.RememberMe" />
					<label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
				</div>

				<div>
					<button id="login-submit" type="submit" class="btn btn-primary w-100">Log in</button>
				</div>

				<div class="mt-4 text-center">
					<a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
					<br />
					<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
					<br />
					<a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
				</div>

				<!-- ✅ External Providers -->
				<div class="mt-5">
					<h3 class="text-center">Or log in with</h3>
					<hr />

					@if ((Model.ExternalLogins?.Count ?? 0) == 0)
					{
						<p class="text-center text-muted">
							No external authentication services configured.
						</p>
					}
					else
					{
						<form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
							<div class="external-providers">
								@foreach (var provider in Model.ExternalLogins!)
								{
									<button type="submit" class="btn btn-external" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
										<i class="fab fa-@provider.Name.ToLower()"></i> @provider.DisplayName
									</button>
								}
							</div>
						</form>
					}
				</div>

			</form>
		</div>

	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

	@section Scripts {
		<partial name="_ValidationScriptsPartial" />
	}

</body>
</html>
